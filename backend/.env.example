# Database Configuration
MONGODB_URI=mongodb://admin:password123@localhost:27017/smart_platform?authSource=admin
REDIS_HOST=localhost
REDIS_PORT=6379
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_LOCAL_DATA_CENTER=datacenter1
CASSANDRA_KEYSPACE=smart_platform
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
ELASTICSEARCH_NODE=http://localhost:9200

# Authentication & Security (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=24h
SESSION_EXPIRY_SECONDS=86400

# Server Configuration
PORT=3000
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
